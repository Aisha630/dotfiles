{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "secondary_prompt": {
    "template": "╰─❯ ",
    "foreground": "#D6DEEB",
    "background": "transparent"
  },
  "transient_prompt": {
    "newline": true,
    "template": "{{ if .Segments.Contains \"TimeLastCommand\" }}  {{ .Segments.TimeLastCommand.FormattedMs }} \n{{ end }}  ",
    "foreground": "#dabd17",
    "background": "transparent"
  },

  "console_title_template": "{{ if .Root }}root @ {{ end }}{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "options": {
            "arch": "",
            "debian": "",
            "linux": "",
            "macos": "",
            "ubuntu": ""
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ if .WSL }} on {{ end }}{{ .Icon }} ",
          "foreground": "#D6DEEB",
          "background": "#7469B6",
          "type": "os",
          "style": "diamond"
        },
        {
          "template": "  admin ",
          "foreground": "#D6DEEB",
          "powerline_symbol": "",
          "background": "#EF541C",
          "type": "root",
          "style": "powerline",
          "cache": {
            "duration": "none"
          }
        },
        {
          "template": "   cmake {{ .Full }} ",
          "foreground": "#E8EAEE",
          "powerline_symbol": "",
          "background": "#1E9748",
          "type": "cmake",
          "style": "powerline",
          "cache": {
            "duration": "none"
          }
        },
        {
          "template": "  {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} ",
          "foreground": "#011627",
          "powerline_symbol": "",
          "background": "#B787D7",
          "type": "python",
          "style": "powerline",
          "cache": {
            "duration": "none"
          }
        },
        {
          "template": "  {{ .Full }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "",
          "background": "#7FD5EA",
          "type": "go",
          "style": "powerline",
          "cache": {
            "duration": "none"
          }
        },
        {
          "template": "  {{ .Full }} ",
          "foreground": "#193549",
          "powerline_symbol": "",
          "background": "#99908A",
          "type": "rust",
          "style": "powerline",
          "cache": {
            "duration": "none"
          }
        },
        {
          "leading_diamond": " ",
          "trailing_diamond": " ",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}",
          "foreground": "#055b9c",
          "background": "#e1e8e9",
          "type": "dart",
          "style": "diamond",
          "cache": {
            "duration": "none"
          }
        },
        {
          "template": " 🥟 {{ .Full }} ",
          "foreground": "#e5b777",
          "type": "bun",
          "style": "plain",
          "cache": {
            "duration": "none"
          }
        },
        {
          "leading_diamond": "",
          "trailing_diamond": "<transparent,#06A4CE></>",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#ffffff",
          "background": "#06A4CE",
          "type": "flutter",
          "style": "diamond",
          "cache": {
            "duration": "none"
          }
        },
        {
          "leading_diamond": "",
          "trailing_diamond": "<transparent,#fe562e></>",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "#ffffff",
          "background": "#fe562e",
          "type": "swift",
          "style": "diamond",
          "cache": {
            "duration": "none"
          }
        },
        {
          "options": {
            "branch_icon": " ",
            "branch_identical_icon": "",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} ",
          "foreground": "#011627",
          "powerline_symbol": "",
          "background": "#E493B3",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#8ACDD7{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#8ACDD7{{ end }}",
            "{{ if gt .Ahead 0 }}#FFEFEF{{ end }}",
            "{{ if gt .Behind 0 }}#FFEFEF{{ end }}"
          ],
          "cache": {
            "duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "options": {
            "always_enabled": true
          },
          "leading_diamond": "",
          "template": " {{ if gt .Code 0 }}{{ else }}{{ end }} ",
          "foreground": "#414141",
          "background": "#BEADFA",
          "type": "status",
          "style": "diamond",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#D6DEEB{{ end }}"
          ],
          "background_templates": [
            "{{ if gt .Code 0 }}#E44141{{ end }}"
          ]
        },
        {
          "options": {
            "style": "roundrock",
            "threshold": 0
          },
          "alias": "TimeLastCommand",
          "trailing_diamond": "",
          "template": "  {{ .FormattedMs }} ",
          "foreground": "#D6DEEB",
          "background": "#575656",
          "type": "executiontime",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "  {{ .Project }} :: {{ .Account }} ",
          "foreground": "#F4B400",
          "type": "gcp",
          "style": "plain",
          "cache": {
            "duration": "none"
          }
        },
        {
          "template": "{{ .Stack }}{{ if .User }} :: {{ .User }}@{{ end }}{{ if .URL }}{{ .URL }}{{ end }}",
          "foreground": "#8759aa",
          "type": "pulumi",
          "style": "plain"
        },
        {
          "template": "  {{ if .SSHSession }} {{ end }}{{ .UserName }}",
          "foreground": "#d964a0",
          "type": "session",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\n╭─",
          "foreground": "#D6DEEB",
          "type": "text",
          "style": "plain",
          "cache": {
            "duration": "none"
          }
        },
        {
          "options": {
            "time_format": "<#D6DEEB> 15:04:05</> <#79DFE1>|</>  2 Jan, Monday"
          },
          "template": "{{ .CurrentDate | date .Format }} <#79DFE1>|</>",
          "foreground": "#F2D3B6",
          "type": "time",
          "style": "plain"
        },
        {
          "options": {
            "folder_icon": "  ",
            "folder_separator_icon": "  ",
            "home_icon": " ",
            "max_depth": 3,
            "style": "agnoster_short"
          },
          "leading_diamond": "<#00C7FC>  </><#B6D6F2> in </>",
          "template": " {{ .Path }} ",
          "foreground": "#B6D6F2",
          "type": "path",
          "style": "diamond"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "╰─",
          "foreground": "#D6DEEB",
          "type": "text",
          "style": "plain",
          "cache": {
            "duration": "none"
          }
        },
        {
          "options": {
            "always_enabled": true
          },
          "template": "❯ ",
          "foreground": "#D6DEEB",
          "type": "status",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 4
}
